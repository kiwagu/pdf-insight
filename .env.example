# Browser build (apps/web): URL of the deployed analyze function, no trailing slash
VITE_API_URL=https://<project-ref>.supabase.co/functions/v1/analyze
# Browser build (apps/web), optional: source repository linked in the footer; no link when empty.
# The Pages workflow sets it from the GitHub context, so it is only needed for other builds.
VITE_REPOSITORY_URL=https://github.com/<owner>/<repo>
